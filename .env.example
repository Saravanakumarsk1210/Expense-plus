# Neon Database & API Credentials
# Replace with your actual Neon PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-cluster.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_API_URL=https://ep-your-cluster.apirest.c-9.us-east-2.aws.neon.tech/neondb/rest/v1

# S3-compatible storage (Optional for receipts)
AWS_ENDPOINT_URL_S3="https://your-s3-endpoint.storage.neon.tech"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_REGION="us-east-2"
